GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0
# Reasoning effort for reasoning-capable models (e.g. openai/gpt-oss-120b).
# "" disables reasoning (faster, but model may not strictly follow JSON-mode);
# "low"/"medium"/"high" enables reasoning (slower, more careful).
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
LLM_MOCK=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO